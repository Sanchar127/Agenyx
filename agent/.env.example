AGENTYX_ENVIRONMENT=development
AGENTYX_DEBUG=false

# Semantic Router
AGENTYX_ROUTER_BASE_URL=http://router:8005
AGENTYX_ROUTER_TIMEOUT_SECONDS=10

# Inference Service
AGENTYX_INFERENCE_BASE_URL=http://inference:8004
AGENTYX_INFERENCE_TIMEOUT_SECONDS=120

# Agent
AGENTYX_AGENT_MAX_STEPS=8

# Authentication
AGENTYX_JWT_SECRET=replace-with-a-secure-secret
AGENTYX_JWT_ALGORITHM=HS256
AGENTYX_JWT_ISSUER=agenyx
AGENTYX_JWT_AUDIENCE=agenyx-api

# Sandbox
AGENTYX_SANDBOX_BASE_URL=http://sandbox:9000
AGENTYX_SANDBOX_TIMEOUT_SECONDS=10
